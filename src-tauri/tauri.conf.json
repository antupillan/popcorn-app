{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "popcorn-app",
  "version": "0.1.0",
  "identifier": "org.popcorn.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "popcorn-app",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "windowEffects": {
          "effects": ["mica", "sidebar"]
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Samuel Paredes",
    "homepage": "https://github.com/antupillan/popcorn-app",
    "copyright": "Copyright © 2026 Samuel Paredes",
    "category": "Video",
    "shortDescription": "Cliente de medios P2P nativo",
    "longDescription": "Cliente de medios P2P nativo (Tauri, motor BitTorrent embebido vía librqbit o desacoplable a qBittorrent/Transmission), con catálogo legal por defecto y comunidades vía relés Nostr.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
